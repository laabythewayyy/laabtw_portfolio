# Copy this file to `.env.local` (same folder) and fill in the three values.
# `.env.local` is never uploaded to GitHub.

# Supabase → Project Settings → API Keys (or Data API) → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_…) or "anon public" key.
# NEVER put the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Supabase → Authentication → Users → click your user → "User UID"
ADMIN_USER_ID=00000000-0000-0000-0000-000000000000
